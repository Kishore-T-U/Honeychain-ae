# ============================================================
# COPY THIS FILE TO ".env.local" AND FILL IN YOUR REAL VALUES.
# Never commit .env.local — it's already in .gitignore.
# ============================================================

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
# <<< FILL ME: your Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# <<< FILL ME: your Supabase "anon / public" key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed later for server-side/admin scripts (seeding data, etc).
# NEVER expose this to the browser or commit it.
# <<< FILL ME (optional for now): Supabase "service_role" key
SUPABASE_SERVICE_ROLE_KEY=
